# What npm may do in this project. tests/hardening.test.ts checks both settings.

# Never run a dependency's install scripts, so a hijacked package can't run code when it is installed. The scripts
# in package.json (npm test, npm run build, ...) still run.
ignore-scripts=true

# Never choose a release under 7 days old, so a hijacked release has time to be caught. `npm install`, `npm update`
# and `<package>@latest` settle for the newest release that is old enough. Asking for a newer one by its exact
# version fails with "No matching version found ... with a date before ..."; for vite, npm 11.19 loops instead of
# failing. To take a newer release on purpose: npm install <package>@<version> --min-release-age=0
min-release-age=7
